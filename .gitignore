# Swift / SwiftPM
.build/
.swiftpm/
DerivedData/

# Xcode user state
xcuserdata/
*.xcuserstate

# Secrets — see specs/tech-stack.md. Real keys never land in the repo;
# Secrets.example.xcconfig (committed, placeholder values) is the template.
Secrets.xcconfig
.env
.env.local

# Web (Next.js / Playwright)
node_modules/
.next/
out/
.vercel/
test-results/
playwright-report/

# Python (the catalog build scripts; build_tv imports enrich_catalog)
__pycache__/
*.pyc

# macOS
.DS_Store

# Harness output — screenshots and mirrored posters are regenerated by
# docs/prototype/drive.js on every run, and the posters are TMDB's, not ours.
docs/prototype/shots/
docs/prototype/posters/

# Review images, regenerated by `node docs/prototype/shots.js review`. They go
# into artifacts and chat, not into git - the repo should not carry a copy of
# TMDB's artwork, and these are reproducible in 30 seconds.
docs/prototype/review/

# A throwaway sweep script with SHOTS unset writes to the literal path
# "undefined/shots/", and `git add -A` committed 3.8MB of it on 2026-11-18.
# One-off harness scripts belong in the scratchpad; this catches the one
# mistake that puts them here anyway. See specs/tech-stack.md.
docs/prototype/undefined/

# Agent worktrees — transient checkouts created by parallel subagents and
# removed when they finish. Never part of the project's history.
.claude/worktrees/
