# Swift / SwiftPM
.build/
.swiftpm/
DerivedData/

# Xcode user state
xcuserdata/
*.xcuserstate

# Secrets — see specs/tech-stack.md. Real keys never land in the repo;
# Secrets.example.xcconfig (committed, placeholder values) is the template.
Secrets.xcconfig
.env
.env.local

# Web (Next.js / Playwright)
node_modules/
.next/
out/
.vercel/
test-results/
playwright-report/

# Python (the catalog build scripts; build_tv imports enrich_catalog)
__pycache__/
*.pyc

# macOS
.DS_Store

# Harness output — screenshots and mirrored posters are regenerated by
# docs/prototype/drive.js on every run, and the posters are TMDB's, not ours.
docs/prototype/shots/
docs/prototype/posters/

# Agent worktrees — transient checkouts created by parallel subagents and
# removed when they finish. Never part of the project's history.
.claude/worktrees/
